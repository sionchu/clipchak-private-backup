NEXT_PUBLIC_SITE_URL=https://clipchak.kr
# generic: { title, items: [{ url, label, kind, delivery }] } 형식의 자체 분석 API
# cobalt: self-hosted cobalt API 응답을 클립착 형식으로 변환
MEDIA_RESOLVER_DRIVER=generic
MEDIA_RESOLVER_ENDPOINT=
MEDIA_RESOLVER_TOKEN=
MEDIA_RESOLVER_AUTH_SCHEME=Bearer
# 클립착은 분석 서버의 tunnel/proxy 응답을 환경 설정과 무관하게 차단합니다.
# 이전 배포와의 호환용. 새 설정에서는 위 MEDIA_* 값을 사용하세요.
VIDEO_RESOLVER_ENDPOINT=
VIDEO_RESOLVER_TOKEN=
